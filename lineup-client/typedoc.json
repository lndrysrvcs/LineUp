{
  "entryPoints": ["src/"],
  "entryPointStrategy": "expand",
  "tsconfig": "./tsconfig.json",
  "outputs": [
    {
      "name": "markdown",
      "path": "docs",
      "options": {
        "entryFileName": "index.md"
      }
    }
  ],
  "exclude": ["**/*.test.tsx", "**/*.test.ts", "node_modules/**", "src/api-client/**", "src/main.tsx"],
  "excludePrivate": true,
  "excludeProtected": false,
  "logLevel": "Info",
  "plugin": ["typedoc-plugin-markdown"]
}
