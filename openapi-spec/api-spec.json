            }
          }
        }
      },
      "FormQuestionAnswer": {
        "required": [
          "question",
          "answerText"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "formQuestionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "answerId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "question": {
            "$ref": "#/components/schemas/FormQuestion"
          },
          "answerText": {
            "type": "string"
          }
        }
      },
      "QuestionOptions": {
        "required": [
          "optionText"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "optionText": {
            "maxLength": 64,
            "type": "string"
          },
          "sortOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "QuestionType": {
        "type": "integer"
      },
      "ScheduleDto": {
        "required": [
          "dateCoverage",
          "startTime",
          "endTime",
          "schedulePreferences",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "guid": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "dateCoverage": {
            "type": "array",
