  "components": {
    "schemas": {
      "Availability": {
        "required": [
          "userName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "guid": {
            "type": "string",
            "format": "uuid"
          },
          "availabilitySlots": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          },
          "userName": {
            "maxLength": 64,
            "type": "string"
          },
          "userEmail": {
            "maxLength": 256,
            "type": [
              "null",
              "string"
            ]
          },
          "preferences": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AvailabilityPreferences"
              }
            ]
          },
          "formAnswers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormQuestionAnswer"
            }
          }
        }
      },
